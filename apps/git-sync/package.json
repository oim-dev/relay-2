{
  "name": "@relay/git-sync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun build --compile --bytecode --format=esm --watch ./src/main.ts --outfile ./dist/relay-git-sync",
    "build": "bun build --compile --bytecode --format=esm ./src/main.ts --outfile ./dist/relay-git-sync",
    "start": "./dist/relay-git-sync",
    "typecheck": "bun --bun tsc --noEmit",
    "test:unit": "bun test .unit.test.ts",
    "test:integration": "bun test .integration.test.ts",
    "test:extended-replication": "bun test ./tests/extended",
    "test:process": "bun test .process.test.ts"
  },
  "dependencies": {
    "@relay/contracts": "workspace:*",
    "@relay/core": "workspace:*",
    "@relay/project-runtime": "workspace:*",
    "@relay/storage": "workspace:*"
  },
  "devDependencies": {
    "@relay/typescript-config": "workspace:*",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  }
}
