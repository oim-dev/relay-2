{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "app/*": ["./src/app/*"],
      "compositions/*": ["./src/compositions/*"],
      "domains/*": ["./src/domains/*"],
      "infra/*": ["./src/infra/*"],
      "ui/*": ["./src/ui/*"],
      "shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src", "*.ts"],
  "exclude": [".templates"]
}
