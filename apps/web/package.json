{
  "name": "@relay/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "create": "bun x @gromlab/create@0.2.0 --skip-update",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const path of ['dist', '.cache']) rmSync(path, { recursive: true, force: true });\"",
    "dev": "node scripts/vite.mjs --host 127.0.0.1",
    "build": "node scripts/vite.mjs build",
    "typecheck": "tsc --noEmit",
    "lint": "bun --bun oxlint --deny-warnings .",
    "browser": "agent-browser --config ./agent-browser.json",
    "browser:install": "agent-browser install",
    "test:unit": "bun test .unit.test.ts",
    "generate:api": "bun run --filter @relay/rest-sdk generate"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@mantine/core": "^9.6.1",
    "@mantine/form": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@mantine/notifications": "^9.6.1",
    "@relay/contracts": "workspace:*",
    "@relay/rest-sdk": "workspace:*",
    "@xyflow/react": "^12.11.6",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "postcss": "^8.5.28",
    "postcss-custom-media": "^12.0.1",
    "postcss-nesting": "^14.0.1",
    "vite": "^8.3.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ]
}
