{
  "name": "@relay/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun scripts/build.ts",
    "start": "./dist/relay-server",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "bun --bun oxlint --deny-warnings .",
    "generate": "bun scripts/generate-api.ts",
    "test:unit": "bun test .unit.test.ts",
    "test:integration": "bun test .integration.test.ts",
    "test:process": "bun test .process.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@relay/contracts": "workspace:*",
    "@relay/core": "workspace:*",
    "@relay/project-runtime": "workspace:*",
    "@relay/storage": "workspace:*",
    "ajv": "8.17.1",
    "fastify": "5.12.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@relay/rest-sdk": "workspace:*",
    "@relay/typescript-config": "workspace:*",
    "@types/bun": "1.4.3",
    "prettier": "3.9.10",
    "ts-json-schema-generator": "2.4.0",
    "typescript": "7.0.2"
  }
}
