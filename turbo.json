{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["bunfig.toml", ".bun-version"],
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**"]
    },
    "@relay/cli#build": {
      "dependsOn": ["^build", "typecheck", "@relay/git-sync#build", "@relay/server#build"],
      "outputs": ["dist/**"]
    },
    "@relay/server#build": {
      "dependsOn": ["^build", "typecheck", "@relay/web#build"],
      "outputs": ["dist/**"]
    },
    "@relay/rest-sdk#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/generated/**"]
    },
    "@relay/rest-sdk#typecheck": {
      "dependsOn": ["^typecheck", "@relay/rest-sdk#build"],
      "outputs": ["dist/generated/**"]
    },
    "@relay/rest-sdk#test:unit": {
      "dependsOn": ["^test:unit", "@relay/rest-sdk#build"],
      "outputs": ["dist/generated/**"]
    },
    "@relay/server#test:integration": {
      "dependsOn": ["@relay/rest-sdk#build"],
      "cache": false,
      "passThroughEnv": ["CI_LOG_DIR"]
    },
    "@relay/web#dev": {
      "dependsOn": ["@relay/rest-sdk#build"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^test:unit"],
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "passThroughEnv": ["CI_LOG_DIR"]
    },
    "test:process": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
