{
  "name": "relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": "1.4.3",
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun x --no-install turbo run dev",
    "dev:cli": "bun x --no-install turbo run dev --filter=@relay/cli",
    "dev:git-sync": "bun x --no-install turbo run dev --filter=@relay/git-sync",
    "dev:server": "bun x --no-install turbo run dev --filter=@relay/server",
    "dev:web": "bun x --no-install turbo run dev --filter=@relay/web",
    "build": "bun x --no-install turbo run build",
    "build:cli": "bun x --no-install turbo run @relay/cli#build @relay/server#build @relay/git-sync#build",
    "build:git-sync": "bun x --no-install turbo run build --filter=@relay/git-sync",
    "build:server": "bun x --no-install turbo run @relay/server#build",
    "build:web": "bun x --no-install turbo run build --filter=@relay/web",
    "generate:api": "bun run --filter @relay/rest-sdk generate",
    "start:cli": "bun run --filter @relay/cli start",
    "start:git-sync": "bun run --filter @relay/git-sync start",
    "start:server": "bun run --filter @relay/server start",
    "lint": "bun x --no-install turbo run lint //#lint:repo --continue=dependencies-successful",
    "lint:repo": "bun --bun oxlint --deny-warnings scripts tests",
    "typecheck": "bun x --no-install turbo run typecheck //#typecheck:repo --continue=dependencies-successful",
    "typecheck:repo": "bun --bun tsc --noEmit -p scripts/tsconfig.json && bun --bun tsc --noEmit -p tests/tsconfig.json",
    "test": "bun run test:unit",
    "test:unit": "bun x --no-install turbo run test:unit //#test:unit:repo",
    "test:unit:repo": "bun test --cwd scripts .unit.test.ts",
    "test:integration": "bun x --no-install turbo run test:integration",
    "test:extended-replication": "bun run --filter @relay/core test:extended-replication && bun run --filter @relay/git-sync test:extended-replication",
    "test:process": "bun x --no-install turbo run test:process --filter=@relay/cli --filter=@relay/git-sync --filter=@relay/server",
    "test:native-service": "bun run --filter @relay/project-runtime test:native-service",
    "test:e2e": "bun x --no-install turbo run test:e2e //#test:e2e:product",
    "test:e2e:product": "bun test --no-orphans ./tests/e2e",
    "test:all": "bun x --no-install turbo run test:unit test:integration test:process test:e2e //#test:unit:repo //#test:e2e:product --continue=dependencies-successful",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "check": "bun scripts/check.ts",
    "verify:configuration": "bun scripts/verification/configuration.ts",
    "ci:generate": "bun scripts/ci/generate.ts",
    "ci:task": "bun scripts/ci/task.ts"
  },
  "devDependencies": {
    "@relay/project-runtime": "workspace:*",
    "@relay/rest-sdk": "workspace:*",
    "@types/bun": "1.4.3",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "7.0.2"
  }
}
