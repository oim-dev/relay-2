{
  "name": "relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": "1.4.3",
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun x --no-install turbo run dev",
    "dev:cli": "bun x --no-install turbo run dev --filter=@relay/cli",
    "dev:git-sync": "bun x --no-install turbo run dev --filter=@relay/git-sync",
    "dev:server": "bun x --no-install turbo run dev --filter=@relay/server",
    "dev:web": "bun x --no-install turbo run dev --filter=@relay/web",
    "build": "bun x --no-install turbo run build",
    "build:cli": "bun x --no-install turbo run @relay/cli#build",
    "build:git-sync": "bun x --no-install turbo run build --filter=@relay/git-sync",
    "build:server": "bun x --no-install turbo run @relay/server#build",
    "build:web": "bun x --no-install turbo run build --filter=@relay/web",
    "generate:api": "bun run --filter @relay/rest-sdk generate",
    "start:cli": "bun run --filter @relay/cli start",
    "start:git-sync": "bun run --filter @relay/git-sync start",
    "start:server": "bun run --filter @relay/server start",
    "lint": "bun --bun oxlint --deny-warnings apps packages tests",
    "typecheck": "bun x --no-install turbo run typecheck && bun --bun tsc --noEmit -p tests/tsconfig.json",
    "test": "bun run test:unit",
    "test:unit": "bun x --no-install turbo run test:unit",
    "test:integration": "bun x --no-install turbo run test:integration",
    "test:extended-replication": "bun run --filter @relay/core test:extended-replication && bun run --filter @relay/git-sync test:extended-replication",
    "test:process": "bun x --no-install turbo run test:process --filter=@relay/cli --filter=@relay/git-sync --filter=@relay/server",
    "test:native-service": "bun run --filter @relay/project-runtime test:native-service",
    "test:e2e": "bun run build:cli && bun test --no-orphans ./tests/e2e",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:process && bun run test:e2e",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run build && bun run test:all"
  },
  "devDependencies": {
    "@relay/rest-sdk": "workspace:*",
    "@types/bun": "1.4.3",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "7.0.2"
  }
}
